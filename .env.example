# Where the dev server proxies /api to (the ConnectOS billing API).
VITE_API_PROXY_TARGET=https://connectosapi.centralnetworks.co.ke

# Production only: absolute API base, e.g. https://api.example.com/api/v1
# Leave unset to call the same origin at /api/v1 (reverse-proxy /api to the API).
# VITE_API_BASE_URL=

# Shown on the Wallet page as the Paybill instructions (optional).
# VITE_MPESA_PAYBILL=
VITE_APP_NAME=ConnectOS

# Public URL of the portal (used for the canonical link).
VITE_APP_URL=https://my.centralnetworks.co.ke
