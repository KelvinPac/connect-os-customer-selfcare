{
  "name": "ConnectOS Customer Portal",
  "short_name": "ConnectOS",
  "description": "Manage your internet plan, wallet, router and support requests.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f5f6fb",
  "theme_color": "#4f46e5",
  "icons": [
    { "src": "/icon-any-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-any-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Router & Wi-Fi", "url": "/router", "icons": [{ "src": "/icon-any-192.png", "sizes": "192x192" }] },
    { "name": "Wallet top-up", "url": "/wallet", "icons": [{ "src": "/icon-any-192.png", "sizes": "192x192" }] },
    { "name": "Support", "url": "/support", "icons": [{ "src": "/icon-any-192.png", "sizes": "192x192" }] }
  ]
}
